---
# Ludus server secrets — the split-out half of ludus_config (standards §7, the
# vars/vault pattern). The master's host_vars/<master>/ludus_config.yml carries
# the non-secret keys and references the name below; the real value lives here,
# encrypted.
#
# This .example is the only thing committed. Create the real, encrypted file and
# pass it on the command line (ansible.cfg does NOT load inventory/secrets/ as an
# inventory source):
#
#   cp inventory/secrets/ludus.yml.example inventory/secrets/ludus.yml
#   $EDITOR inventory/secrets/ludus.yml          # paste the real key
#   ansible-vault encrypt inventory/secrets/ludus.yml
#   ansible-playbook playbooks/ludus-server-install.yml \
#       -e @inventory/secrets/ludus.yml --ask-vault-pass
#
# The database_encryption_key decrypts every stored credential. The install role
# NEVER rewrites a live one; when this value is set it only asserts the running
# config.yml matches it, so a typo here fails loudly instead of bricking the
# server. On a brand-new install the installer generates the key — read it back
# into this file afterwards (from database_encryption_key in /opt/ludus/config.yml)
# so the inventory stays the source of truth.

# The 32-char key from `database_encryption_key:` in /opt/ludus/config.yml.
vault_ludus_database_encryption_key: "CHANGE-ME-32-char-database-key--"
