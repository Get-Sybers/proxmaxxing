---
# Host networking for the Ludus server config.yml, written by
# playbooks/ludus-config-discover.yml from the live {{ inventory_hostname }}
# (the interface carrying the default route, its address and netmask, and the
# gateway). host_vars/{{ inventory_hostname }}/ludus_config.yml references these.
# They are reconciled onto /opt/ludus/config.yml only when
# cluster_ludus_install_manage_network is true (run-sheet caution C1).
ludus_net_interface: "{{ __lcd_net.ludus_net_interface }}"
ludus_net_local_ip: "{{ __lcd_net.ludus_net_local_ip }}"
ludus_net_public_ip: "{{ __lcd_net.ludus_net_public_ip }}"
ludus_net_gateway: "{{ __lcd_net.ludus_net_gateway }}"
ludus_net_netmask: "{{ __lcd_net.ludus_net_netmask }}"
